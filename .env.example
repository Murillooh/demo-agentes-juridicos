# Mesmo projeto Supabase do demo-agentes-juridicos (mesma base Postgres,
# tabelas novas - não precisa criar projeto Supabase separado).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role - só usada no servidor (provisionamento de escritório/advogado,
# operações que precisam ignorar RLS). NUNCA expor no client.
SUPABASE_SERVICE_ROLE_KEY=

# Geração de petição por IA (Etapa 2). Sem ela, a tela mostra erro claro em
# vez de travar. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Etapa 4/5 - protege as rotas /api/cron/* (só a Vercel Cron ou quem tiver
# esse segredo consegue disparar o job). Qualquer string aleatória longa.
# Sem ela, a rota fica desligada (503) em vez de aberta pra qualquer um na
# internet.
CRON_SECRET=

# Etapa 5 - e-mail de notificação (prazo novo, atualização do Diário) via
# Resend. Sem elas, a tela mostra erro claro em vez de travar.
# https://resend.com/api-keys - RESEND_FROM precisa ser um remetente
# verificado no Resend (em teste, "onboarding@resend.dev" entrega só pro
# e-mail dono da conta).
RESEND_API_KEY=
RESEND_FROM=

# Etapa 5 - WhatsApp de notificação via Twilio. Sandbox
# (https://console.twilio.com -> Messaging -> Try it out -> WhatsApp) não
# precisa de aprovação prévia do WhatsApp Business, só o destinatário mandar
# "join <código>" pro número de sandbox. TWILIO_WHATSAPP_FROM é esse número,
# no formato "whatsapp:+14155238886".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Etapa 7 - integração com Google Drive, por escritório. Criar em
# https://console.cloud.google.com -> criar projeto (ou usar um existente)
# -> APIs & Services -> OAuth consent screen (External, adiciona seu
# e-mail como test user enquanto o app não passar por revisão do Google -
# suficiente pra uso próprio/demo) -> Credentials -> Create Credentials ->
# OAuth client ID -> tipo "Web application":
#   - Authorized redirect URIs: valor igual a GOOGLE_REDIRECT_URI abaixo
#     (tem que bater exatamente).
#   - Depois de criado, "Client ID" e "Client secret" aparecem na tela.
# Escopo usado pelo app: drive.file (só arquivo que o próprio app cria,
# nunca o Drive inteiro da conta) + userinfo.email. Não tem custo - API do
# Google Drive é gratuita pro volume de uso daqui. Sem essas 3 env vars, a
# rota /api/integracoes/googledrive/conectar devolve 503 em vez de travar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integracoes/googledrive/callback

# Etapa 9 - URL pública do site, usada no link de login do e-mail de
# boas-vindas do acesso demo (app/demo/actions.js). Sem barra no final.
NEXT_PUBLIC_APP_URL=http://localhost:3000
