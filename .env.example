# Mesmo projeto Supabase do demo-agentes-juridicos (mesma base Postgres,
# tabelas novas - não precisa criar projeto Supabase separado).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role - só usada no servidor (provisionamento de escritório/advogado,
# operações que precisam ignorar RLS). NUNCA expor no client.
SUPABASE_SERVICE_ROLE_KEY=

# Geração de petição por IA (Etapa 2). Sem ela, a tela mostra erro claro em
# vez de travar. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Etapa 4/5 - protege as rotas /api/cron/* (só a Vercel Cron ou quem tiver
# esse segredo consegue disparar o job). Qualquer string aleatória longa.
# Sem ela, a rota fica desligada (503) em vez de aberta pra qualquer um na
# internet.
CRON_SECRET=

# Etapa 5 - e-mail de notificação (prazo novo, atualização do Diário) via
# Resend. Sem elas, a tela mostra erro claro em vez de travar.
# https://resend.com/api-keys - RESEND_FROM precisa ser um remetente
# verificado no Resend (em teste, "onboarding@resend.dev" entrega só pro
# e-mail dono da conta).
RESEND_API_KEY=
RESEND_FROM=

# Etapa 5 - WhatsApp de notificação via Twilio. Sandbox
# (https://console.twilio.com -> Messaging -> Try it out -> WhatsApp) não
# precisa de aprovação prévia do WhatsApp Business, só o destinatário mandar
# "join <código>" pro número de sandbox. TWILIO_WHATSAPP_FROM é esse número,
# no formato "whatsapp:+14155238886".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Etapa 7 - integração com OneDrive (Microsoft Graph), por escritório.
# Criar em https://portal.azure.com -> Microsoft Entra ID -> App
# registrations -> New registration:
#   - Supported account types: "Accounts in any organizational directory
#     and personal Microsoft accounts" (é o que permite qualquer
#     escritório conectar a própria conta, pessoal ou corporativa).
#   - Redirect URI: tipo "Web", valor igual a MICROSOFT_REDIRECT_URI
#     abaixo (tem que bater exatamente).
#   - API permissions (delegated): Files.ReadWrite, offline_access, User.Read.
#   - Certificates & secrets -> New client secret -> MICROSOFT_CLIENT_SECRET.
# Sem essas 3, a rota /api/integracoes/onedrive/conectar devolve 503 em vez
# de travar.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/integracoes/onedrive/callback
